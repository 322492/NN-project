{
  "seed": 42,
  "description": "YOLOv8 single-class detection on full ENA24 (~8789 images). Omit data.size in prepare script for all images.",

  "detection": {
    "single_class": true,
    "class_name": "object"
  },

  "data": {
    "coco_dir": "../data/ena24_full",
    "output_dir": "../data/ena24_yolo_full",
    "size": null,
    "train_ratio": 0.6,
    "val_ratio": 0.2,
    "test_ratio": 0.2,
    "copy_images": false,
    "split_strategy": "manifest",
    "split_manifest_path": "../data/ena24_full/metadata/split_manifest.json",
    "group_manifest_path": "../data/ena24_full/metadata/group_manifest.json"
  },

  "model": {
    "weights": "yolov8n.pt"
  },

  "training": {
    "epochs": 20,
    "imgsz": 640,
    "batch": 16,
    "device": "auto",
    "patience": 15,
    "project": "../runs/detect",
    "name": "ena24_yolo_full",
    "workers": 4,
    "pretrained": true
  },

  "inference": {
    "conf_threshold": 0.25,
    "iou_threshold": 0.45
  },

  "metrics": {
    "iou_threshold": 0.5
  },

  "checkpoints": {
    "best_checkpoint_path": "../checkpoints/yolo_full_best.pt"
  },


  "wandb": {
    "enabled": true,
    "project": "ena24-yolo-detector-v2"
  }
}
